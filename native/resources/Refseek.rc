#include <winver.h>

1 VERSIONINFO
FILEVERSION 2,0,1,0
PRODUCTVERSION 2,0,1,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Y1-studio\0"
            VALUE "FileDescription", "Refseek Desktop\0"
            VALUE "FileVersion", "2.0.1\0"
            VALUE "InternalName", "Refseek-Desktop\0"
            VALUE "OriginalFilename", "Refseek-Desktop.exe\0"
            VALUE "ProductName", "Refseek\0"
            VALUE "ProductVersion", "2.0.1\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
